# Определяем переменную BIN, которая содержит имя итогового исполняемого файла
BIN := streams_shop

# Находим все файлы с расширением .c в текущей директории и сохраняем их в переменную SRC
SRC := $(wildcard *.c)

# Создаем список объектных файлов, заменяя расширение .c на .o у всех файлов из SRC
OBJ := $(SRC:.c=.o)

# Определяем компилятор C
CC := gcc

# Флаги компиляции: добавляем поддержку pthread и предупреждения
CFLAGS := -Wall -Wextra -pthread
LDFLAGS := -pthread

# Правило сборки итогового исполняемого файла: он зависит от всех объектных файлов
$(BIN): $(OBJ)
	$(CC) $^ -o $@ $(LDFLAGS)

# Правило сборки объектных файлов: каждый .o файл зависит от соответствующего .c файла
%.o: %.c interface.h
	$(CC) $(CFLAGS) -c $< -o $@

# Объявляем цели как phony
.PHONY: clean all run

# Цель по умолчанию
all: $(BIN)

# Правило для запуска программы
run: $(BIN)
	./$(BIN)

# Правило для очистки проекта
clean:
	rm -rf *.o $(BIN)