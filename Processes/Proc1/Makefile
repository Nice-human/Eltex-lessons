# Определяем переменную BIN, которая содержит имя итогового исполняемого файла
BIN := proc1

# Находим все файлы с расширением .c в текущей директории и сохраняем их в переменную SRC
SRC := $(wildcard *.c)

# Создаем список объектных файлов, заменяя расширение .c на .o у всех файлов из SRC
OBJ := $(SRC:.c=.o)

# Определяем компилятор C
CC := gcc

# Правило сборки итогового исполняемого файла: он зависит от всех объектных файлов
$(BIN): $(OBJ)
		# Команда: скомпилировать все объектные файлы ($^) в исполняемый файл ($@)
		$(CC) $^ -o $@ 

# Правило сборки объектных файлов: каждый .o файл зависит от соответствующего .c файла и заголовочного файла
%.o: %.c
		# Команда: скомпилировать исходный файл ($<) в объектный файл ($@)
		$(CC) -c $< -o $@

# Объявляем цель clean как phony (фиктивную), чтобы Make не искал файл с именем clean
.PHONY: clean

# Правило для очистки проекта - удаляет все объектные файлы и исполняемый файл
clean:
		rm -rf *.o $(BIN)